{
  "expo": {
    "name": "MOMO Corn",
    "slug": "APK",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "jsEngine": "hermes",
    "newArchEnabled": true,
    "android": {
      "package": "com.ourspace.app",
      "softwareKeyboardLayoutMode": "resize",
      "adaptiveIcon": {
        "backgroundColor": "#E6F4FE",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      }
    },
    "plugins": [
      "@react-native-community/datetimepicker",
      [
        "expo-image-picker",
        {
          "photosPermission": "允许访问相册以选择照片",
          "cameraPermission": "允许使用相机拍摄照片"
        }
      ],
      [
        "expo-media-library",
        {
          "photosPermission": "允许访问您的相册以保存图片",
          "savePhotosPermission": "允许保存聊天和打卡图片到您的相册",
          "isAccessMediaLocationEnabled": true,
          "granularPermissions": [
            "photo"
          ]
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "允许使用麦克风录制语音信箱的私密语音消息",
          "recordAudioAndroid": true
        }
      ],
      "expo-sharing",
      "expo-asset",
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "014e91f2-0b81-40ea-8881-f02a6de1df8f"
      }
    }
  }
}
